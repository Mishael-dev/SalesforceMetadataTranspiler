<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <deploymentStatus>Deployed</deploymentStatus>
  <description>Represents hardware devices assigned to employees or departments.</description>
  <label>Device</label>
  <pluralLabel>Devices</pluralLabel>
  <nameField>
    <label>Device Name</label>
    <type>Text</type>
    <trackHistory>false</trackHistory>
  </nameField>
  <allowInChatterGroups>true</allowInChatterGroups>
  <enableActivities>true</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>true</enableHistory>
  <enableLicensing>false</enableLicensing>
  <enableReports>true</enableReports>
  <enableSearch>true</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <visibility>Public</visibility>
  <externalSharingModel>ReadWrite</externalSharingModel>
  <sharingModel>ReadWrite</sharingModel>
  <fields>
    <fullName>Device_Serial__c</fullName>
    <label>Device Serial Number</label>
    <type>AutoNumber</type>
    <description>System-generated serial number for internal tracking.</description>
    <trackHistory>false</trackHistory>
    <externalId>false</externalId>
    <displayFormat>DEV-{000000}</displayFormat>
    <startingNumber>1</startingNumber>
  </fields>
  <fields>
    <fullName>Warranty_Check__c</fullName>
    <label>Device Warranty Check</label>
    <description>Determines warranty status based on the device name.</description>
    <trackHistory>false</trackHistory>
    <externalId>false</externalId>
    <required>false</required>
    <unique>false</unique>
    <formula>IF(CONTAINS(Name, &quot;Refurbished&quot;), &quot;Limited Warranty&quot;, &quot;Full Warranty&quot;)</formula>
    <type>Text</type>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
  </fields>
  <fields>
    <fullName>Active__c</fullName>
    <label>Active</label>
    <type>Checkbox</type>
