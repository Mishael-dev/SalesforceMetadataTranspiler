{
  "compilerOptions": {
    "outDir": "./dist",             // compiled JS + .d.ts goes here
    "rootDir": "./src",
    "target": "ES2020",
    "module": "ESNext",           // or "ESNext" if you want ESM support
    "strict": true,
    "esModuleInterop": true,        // helps with default imports
    "moduleResolution": "node",
    "declaration": true,            // ✅ generate .d.ts files
    "declarationMap": true,         // optional, useful for debugging
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
